{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 24,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "vs2026-base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "generator": "Visual Studio 18 2026",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "${sourceDir}/deps/build/vs2026/destdir/usr/local",
                "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "${sourceDir}/cmake/DepsPrefetch.cmake",
                "BBL_RELEASE_TO_PUBLIC": "1"
            },
            "environment": {
                "VSLANG": "1033"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "vs2026-debug",
            "displayName": "Visual Studio 2026 Debug",
            "inherits": "vs2026-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "vs2026-release",
            "displayName": "Visual Studio 2026 Release",
            "inherits": "vs2026-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "vs2026-debug",
            "configurePreset": "vs2026-debug",
            "configuration": "Debug"
        },
        {
            "name": "vs2026-release",
            "configurePreset": "vs2026-release",
            "configuration": "Release"
        }
    ]
}
