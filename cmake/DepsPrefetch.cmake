# Provides the deps for the vs2026-* presets, which include this file through CMAKE_PROJECT_TOP_LEVEL_INCLUDES.
# Before the app's first project() call it makes sure that deps/build/vs2026/destdir matches deps/:
# it downloads the prebuilt archive that .github/workflows/fork_deps_windows.yml publishes for the current
# deps/ tree, or builds deps/ locally when no archive exists or deps/ has local changes.

include_guard(GLOBAL)

option(BBL_DEPS_PREFETCH "Download or build the deps automatically during configure" ON)
set(BBL_DEPS_URL "https://github.com/xahon/BambuStudio/releases/download" CACHE STRING "Base URL of the prebuilt deps releases")


function(_bbl_deps_key out_key out_local)
    set(${out_key} "" PARENT_SCOPE)
    set(${out_local} TRUE PARENT_SCOPE)
    find_program(_bbl_git git)
    if (NOT _bbl_git)
        return()
    endif ()
    execute_process(COMMAND "${_bbl_git}" rev-parse HEAD:deps WORKING_DIRECTORY "${_bbl_root}" OUTPUT_VARIABLE _tree RESULT_VARIABLE _rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if (NOT _rc EQUAL 0 OR _tree STREQUAL "")
        return()
    endif ()
    execute_process(COMMAND "${_bbl_git}" status --porcelain --untracked-files=all -- deps ":!deps/build" WORKING_DIRECTORY "${_bbl_root}" OUTPUT_VARIABLE _status RESULT_VARIABLE _rc ERROR_QUIET)
    if (NOT _rc EQUAL 0)
        return()
    endif ()
    if (_status STREQUAL "")
        set(${out_key} "${_tree}" PARENT_SCOPE)
        set(${out_local} FALSE PARENT_SCOPE)
        return()
    endif ()
    execute_process(COMMAND "${_bbl_git}" diff HEAD -- deps ":!deps/build" WORKING_DIRECTORY "${_bbl_root}" OUTPUT_VARIABLE _diff ERROR_QUIET)
    string(SHA256 _local_hash "${_status}${_diff}")
    string(SUBSTRING "${_local_hash}" 0 12 _local_hash)
    set(${out_key} "${_tree}-local-${_local_hash}" PARENT_SCOPE)
endfunction()


function(_bbl_deps_download key out_ok)
    set(${out_ok} FALSE PARENT_SCOPE)
    string(SUBSTRING "${key}" 0 12 _tag)
    set(_asset "deps-vs2026-x64.tar.zst")
    set(_url "${BBL_DEPS_URL}/deps-${_tag}/${_asset}")
    set(_archive "${_bbl_deps_bin}/${_asset}")
    file(DOWNLOAD "${_url}.sha256" "${_archive}.sha256" STATUS _status)
    list(GET _status 0 _code)
    if (NOT _code EQUAL 0)
        file(REMOVE "${_archive}.sha256")
        message(STATUS "Deps: no prebuilt archive at ${_url}")
        return()
    endif ()
    file(READ "${_archive}.sha256" _checksum)
    file(REMOVE "${_archive}.sha256")
    string(REGEX MATCH "^[0-9a-fA-F]+" _hash "${_checksum}")
    string(LENGTH "${_hash}" _hash_length)
    if (NOT _hash_length EQUAL 64)
        message(WARNING "Deps: invalid checksum file at ${_url}.sha256")
        return()
    endif ()

    message(STATUS "Deps: downloading ${_url}")
    file(DOWNLOAD "${_url}" "${_archive}" SHOW_PROGRESS EXPECTED_HASH SHA256=${_hash} STATUS _status)
    list(GET _status 0 _code)
    if (NOT _code EQUAL 0)
        file(REMOVE "${_archive}")
        list(GET _status 1 _message)
        message(WARNING "Deps: download failed: ${_message}")
        return()
    endif ()

    message(STATUS "Deps: extracting into ${_bbl_deps_destdir}")
    set(_staging "${_bbl_deps_bin}/destdir.new")
    file(REMOVE_RECURSE "${_staging}")
    file(ARCHIVE_EXTRACT INPUT "${_archive}" DESTINATION "${_staging}")
    file(REMOVE "${_archive}")
    if (NOT EXISTS "${_staging}/relocate.txt" OR NOT IS_DIRECTORY "${_staging}/usr/local")
        file(REMOVE_RECURSE "${_staging}")
        message(WARNING "Deps: the archive from ${_url} has an unexpected layout")
        return()
    endif ()

    # The archive lists the files that embed the install path of the machine that built it; point them here.
    file(STRINGS "${_staging}/relocate.txt" _relocate)
    list(POP_FRONT _relocate _old_prefix)
    file(TO_NATIVE_PATH "${_old_prefix}" _old_prefix_native)
    file(TO_NATIVE_PATH "${_bbl_deps_destdir}" _new_prefix_native)
    foreach (_file IN LISTS _relocate)
        if (EXISTS "${_staging}/${_file}")
            file(READ "${_staging}/${_file}" _content)
            string(REPLACE "${_old_prefix}" "${_bbl_deps_destdir}" _content "${_content}")
            string(REPLACE "${_old_prefix_native}" "${_new_prefix_native}" _content "${_content}")
            file(WRITE "${_staging}/${_file}" "${_content}")
        endif ()
    endforeach ()
    file(REMOVE "${_staging}/relocate.txt")

    file(REMOVE_RECURSE "${_bbl_deps_destdir}")
    file(RENAME "${_staging}" "${_bbl_deps_destdir}")
    set(${out_ok} TRUE PARENT_SCOPE)
endfunction()


function(_bbl_deps_build)
    message(STATUS "Deps: building deps/ locally into ${_bbl_deps_destdir}. A full build compiles about 30 libraries and takes a long time; the build log follows.")
    execute_process(COMMAND "${CMAKE_COMMAND}" --preset vs2026 WORKING_DIRECTORY "${_bbl_root}/deps" RESULT_VARIABLE _rc)
    if (NOT _rc EQUAL 0)
        message(FATAL_ERROR "Deps: configuring deps/ failed (see the log above)")
    endif ()
    execute_process(COMMAND "${CMAKE_COMMAND}" --build --preset vs2026 WORKING_DIRECTORY "${_bbl_root}/deps" RESULT_VARIABLE _rc)
    if (NOT _rc EQUAL 0)
        message(FATAL_ERROR "Deps: building deps/ failed (see the log above). Rerun configure to resume.")
    endif ()
endfunction()


function(_bbl_deps_prefetch)
    get_filename_component(_bbl_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    set(_bbl_deps_bin "${_bbl_root}/deps/build/vs2026")
    set(_bbl_deps_destdir "${_bbl_deps_bin}/destdir")
    set(_stamp "${_bbl_deps_bin}/deps-key.txt")

    _bbl_deps_key(_key _local)
    set(_old_key "")
    if (EXISTS "${_stamp}")
        file(READ "${_stamp}" _old_key)
        string(STRIP "${_old_key}" _old_key)
    endif ()

    if (IS_DIRECTORY "${_bbl_deps_destdir}/usr/local")
        if (NOT EXISTS "${_stamp}")
            message(STATUS "Deps: using ${_bbl_deps_destdir} as is (not provided by DepsPrefetch; delete it to have the deps downloaded or rebuilt)")
            return()
        endif ()
        if (_key STREQUAL _old_key OR (_key STREQUAL "" AND NOT _old_key STREQUAL "pending"))
            message(STATUS "Deps: up to date (${_old_key})")
            return()
        endif ()
    endif ()

    file(MAKE_DIRECTORY "${_bbl_deps_bin}")
    # Marks an interrupted download or build, so that the next configure resumes it.
    file(WRITE "${_stamp}" "pending\n")
    set(_ok FALSE)
    if (NOT _local)
        _bbl_deps_download("${_key}" _ok)
    endif ()
    if (NOT _ok)
        _bbl_deps_build()
    endif ()
    if (_key STREQUAL "")
        set(_key "unknown")
    endif ()
    file(WRITE "${_stamp}" "${_key}\n")
endfunction()


if (BBL_DEPS_PREFETCH)
    _bbl_deps_prefetch()
endif ()
